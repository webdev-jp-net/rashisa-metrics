# OS / editor
.DS_Store

# Dependencies
node_modules/

# claude
.claude/tmp
.claude/settings.local.json
.claude/launch.json
.claude/worktrees

# serena (ツールが自動生成・自動更新するため追跡しない)
.serena/

# playwright-mcp (実行時の生成物)
.playwright-mcp/

# エージェントの実行記録（テンプレートのみ追跡し、記録の実体は追跡しない）
_llm-memories/*
!_llm-memories/templates/

# 原稿・お手本コーパス（原資料）と、コードが読み書きするデータ・媒体設定。どちらも非追跡
/source/
/data/

# next.js
.next/
next-env.d.ts
out/
*.tsbuildinfo

# 環境変数（APIキー等の秘密情報を含む。.env.exampleは追跡する）
.env.local

# Pythonのバイトコードキャッシュ（tools/find-cliche/実行時に生成）
__pycache__/
